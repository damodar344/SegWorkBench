/* Light theme stylesheet for SegWorkbench */

QMainWindow {
    background-color: #f0f0f0;
}

QTabWidget::pane {
    border: 1px solid #d0d0d0;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #e8e8e8;
    color: #333333;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QTabBar::tab:hover:!selected {
    background-color: #dcdcdc;
}

QPushButton {
    background-color: #0078d4;
    color: #ffffff;
    border: none;
    padding: 6px 14px;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #106ebe;
}

QPushButton:pressed {
    background-color: #005a9e;
}

QLabel {
    color: #333333;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #b0b0b0;
    padding: 4px;
}

QGroupBox {
    color: #333333;
    border: 1px solid #b0b0b0;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QStatusBar {
    background-color: #0078d4;
    color: #ffffff;
}
